{
  "name": "agent",
  "private": true,
  "version": "1.0.0",
  "description": "Multi-PC Audio Monitor Agent",
  "author": "syhn foss",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "~6.0.2",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "obs-websocket-js": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.1"
  },
  "build": {
    "appId": "com.audiomonitor.agent",
    "productName": "Audio Monitor Agent",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "publisherName": "syhn foss"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "AudioMonitor_Agent_Installer_v1.0.exe",
      "uninstallDisplayName": "Audio Monitor Agent"
    }
  }
}
